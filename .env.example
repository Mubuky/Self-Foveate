# OpenAI API Configuration (for framework and evaluation)
# Copy this file to .env and fill in your actual values
# IMPORTANT: Never commit your .env file to version control

# ==============================================================================
# Self-Foveate Framework API (for instruction generation)
# ==============================================================================

# Your OpenAI API key (required)
OPENAI_API_KEY=your-openai-api-key-here

# Optional: Model to use (default: gpt-4o-mini for framework, gpt-4o for evaluation)
OPENAI_MODEL=gpt-4o-mini

# Optional: Base URL for OpenAI API (default: https://api.openai.com/v1)
OPENAI_BASE_URL=https://api.openai.com/v1

# ==============================================================================
# Embedding API Configuration (optional, for EmDiv.py diversity evaluation)
# ==============================================================================

# If not specified, these will default to the OPENAI_* values above
# EMBEDDING_API_KEY=your-embedding-api-key-here
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_BASE_URL=https://api.openai.com/v1

# ==============================================================================
# Inference Model Configuration (for model_evaluation.py)
# This is the model being TESTED, typically a local vLLM instance
# ==============================================================================

# API key for inference model (use 'EMPTY' for local vLLM without authentication)
INFERENCE_API_KEY=EMPTY

# Model name for the inference model being tested
INFERENCE_MODEL=Model

# Base URL for inference API (typically local vLLM server)
INFERENCE_BASE_URL=http://localhost:55755/v1

# Note: model_evaluation.py requires both OPENAI_* (for LLM judging) and INFERENCE_* (for the model being tested)
